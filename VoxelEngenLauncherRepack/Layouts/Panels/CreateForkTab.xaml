<UserControl xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"  x:Class="VoxelEngenLauncherRepack.Layouts.CreateForkTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VoxelEngenLauncherRepack.Layouts"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid x:Name="ModGrid">
            <Grid Background="#7FFFFFFF" HorizontalAlignment="Right" Width="226">
                <TextBox x:Name="eEB_DirectoryName" Text="custom_version" HorizontalAlignment="Center" Margin="0,26,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="206"/>
                <TextBlock Text="{DynamicResource NameFork}" HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
                <TextBlock Text="{DynamicResource CoreVersion}" HorizontalAlignment="Left" Margin="10,44,0,0" TextWrapping="Wrap" VerticalAlignment="Top"/>
                <ComboBox x:Name="eCB_CoreVersionList" Height="21" HorizontalAlignment="Center" Margin="0,60,0,0" VerticalAlignment="Top" Width="206"/>
                <Button x:Name="eB_CreatePork" Content="Создать" Height="20" HorizontalAlignment="Right" Margin="0,0,10,35" VerticalAlignment="Bottom" Width="142" Click="eB_CreatePork_Click"/>
                <ProgressBar x:Name="nePB_Compilate" Margin="0,440,0,0" Height="10" VerticalAlignment="Top"/>

                <Label Content="{DynamicResource InformationDescript}" Margin="10,86,10,0" Height="31" VerticalAlignment="Top"/>
                <TextBlock Margin="10,117,10,85" RenderTransformOrigin="0.5,0.5">
                </TextBlock>
            </Grid>
            <Grid x:Name="GridListBox" Background="#82848282" Margin="0,0,231,0">
                <TabControl Background="#7F8C8B8B">
                    <TabItem Header="Браузер">
                        <Wpf:WebView2 x:Name="VW_Site"/>
                    </TabItem>
                    <TabItem Header="Скачанные">
                        <ListView>
                            
                        </ListView>
                    </TabItem>
                </TabControl>
              
            </Grid>
        </Grid>
    </Grid>
</UserControl>
